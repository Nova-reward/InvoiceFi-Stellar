// Prisma schema for the InvoiceFi-Stellar backend.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InvoiceStatus {
  PENDING
  FUNDED
  REPAID
  DEFAULTED
}

/// Kind of regulatory export a job produces.
enum ExportType {
  TRANSACTIONS
  INVESTOR_REPORT
}

/// Serialization format of an export document.
enum ExportFormat {
  JSON
  CSV
}

/// Lifecycle of an asynchronous export job.
enum ExportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// Off-chain mirror of an on-chain invoice. `onchainId` is the invoice id
/// allocated by the Soroban invoice contract and is the join key used by the
/// settlement event listener.
model Invoice {
  id           Int           @id @default(autoincrement())
  onchainId    BigInt        @unique
  status       InvoiceStatus @default(PENDING)
  faceValue    BigInt
  /// @privacy retention: 365 days after settlement or creation, whichever is later; legal_basis: contract-performance, settlement-operations, fraud-prevention
  farmer       String
  /// @privacy retention: 365 days after settlement or creation, whichever is later; legal_basis: contract-performance, settlement-operations, fraud-prevention
  investor     String?
  /// Wallet address of the entity funding the invoice. Replaces the deprecated investor column.
  /// @privacy retention: 365 days after settlement or creation, whichever is later; legal_basis: contract-performance, settlement-operations, fraud-prevention
  funder       String?
  /// Discount percentage applied to invoice (0-100). Nullable for backward compatibility.
  discountPercentage Decimal?  @db.Decimal(5, 2)
  /// Ledger sequence in which the on-chain settlement was observed.
  settledLedger Int?
  settledAt    DateTime?
  /// Price the investor actually paid to fund the invoice (in the asset's
  /// minor units). Optional — absent for invoices funded before economic-term
  /// capture; investor P&L falls back to `faceValue` (par) when null.
  fundedAmount BigInt?
  /// Amount actually collected when the invoice was repaid, in minor units.
  /// Optional for the same reason as `fundedAmount`.
  repaidAmount BigInt?
  /// Settlement asset code (e.g. "USDC"). Optional; defaults to the
  /// deployment's configured asset when null.
  assetCode    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  events       InvoiceEvent[]

  @@index([status])
  @@index([farmer])
  @@index([investor])
  @@index([funder])
}

/// An asynchronous regulatory export request and its signed result.
///
/// The serialized document (`content`) is the exact byte sequence covered by
/// `sha256` and `signature`; integrity metadata is stored alongside it rather
/// than embedded, so the bytes a verifier hashes never depend on the proof.
model ExportJob {
  id              String          @id @default(uuid())
  type            ExportType
  format          ExportFormat
  status          ExportJobStatus @default(PENDING)
  /// Wallet address of the authenticated requester (audit trail).
  requestedBy     String
  /// Role the requester held at request time ("admin" | "investor" | ...).
  requesterRole   String
  /// Wallet the export is scoped to. Null means "all subjects" (admin only).
  subject         String?
  /// FATF Travel Rule threshold applied, as a minor-units decimal string.
  thresholdMinorUnits String?
  /// Inclusive lower/upper bounds on transaction date, when supplied.
  rangeStart      DateTime?
  rangeEnd        DateTime?
  /// Number of records in the completed document.
  recordCount     Int?
  /// Length of `content` in UTF-8 bytes.
  byteLength      Int?
  /// Hex-encoded SHA-256 of `content`.
  sha256          String?
  /// Base64-encoded ed25519 signature of `content` by the compliance key.
  signature       String?
  /// Stellar public key (G...) of the compliance signing key.
  signerPublicKey String?
  /// Serialized export document (JSON or CSV). Populated once COMPLETED.
  content         String?
  /// MIME type of `content`.
  contentType     String?
  /// Failure reason when status is FAILED.
  error           String?
  createdAt       DateTime        @default(now())
  startedAt       DateTime?
  completedAt     DateTime?

  @@index([requestedBy])
  @@index([status])
}

/// Singleton row tracking the last Soroban ledger the event listener has
/// processed, so polling resumes from the correct cursor after a restart.
model SyncCursor {
  id         Int      @id @default(1)
  lastLedger Int      @default(0)
  updatedAt  DateTime @updatedAt
}

/// Lifecycle of a single queued webhook delivery attempt sequence.
enum WebhookDeliveryStatus {
  /// Waiting for `nextAttemptAt`, or waiting to be picked up for the first time.
  PENDING
  /// Claimed by a worker and currently being attempted (see `lockedAt`).
  PROCESSING
  /// The subscriber returned a 2xx response.
  DELIVERED
  /// All retries in the backoff schedule were exhausted without success.
  ABANDONED
}

/// An HTTP endpoint a farmer or investor has registered to receive invoice
/// lifecycle notifications (created, submitted, funded, repaid, defaulted).
model WebhookSubscription {
  id         String   @id @default(uuid())
  /// Wallet address of the farmer/investor who owns this subscription.
  ownerId    String
  url        String
  /// HMAC-SHA256 signing secret used to sign every delivery. Generated
  /// server-side at registration and returned to the caller exactly once.
  secret     String
  /// Invoice lifecycle event types this subscription receives. `["*"]` means
  /// all event types.
  eventTypes String[]
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([ownerId])
  @@index([active])
}

/// A single queued invoice-event notification for one subscription. Acts as
/// the persistent delivery queue: a scheduled worker claims PENDING rows
/// whose `nextAttemptAt` has passed (see WebhookDeliveryWorkerService),
/// attempts HTTP delivery, and reschedules or abandons on failure.
model WebhookDelivery {
  id             String                @id @default(uuid())
  subscription   WebhookSubscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subscriptionId String
  eventType      String
  /// Deterministic hash of the source event, unique per subscription. Lets
  /// a re-emitted (duplicate) lifecycle event be enqueued safely without
  /// creating a second delivery for the same subscriber.
  idempotencyKey String
  /// The full InvoiceEvent payload sent to the subscriber, verbatim.
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attemptCount   Int                   @default(0)
  nextAttemptAt  DateTime              @default(now())
  /// Set while a worker holds this row in PROCESSING; used to reclaim rows
  /// left behind by a worker that crashed mid-delivery.
  lockedAt       DateTime?
  lastAttemptAt  DateTime?
  lastStatusCode Int?
  lastError      String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  attempts WebhookDeliveryAttempt[]

  @@unique([subscriptionId, idempotencyKey])
  @@index([status, nextAttemptAt])
}

/// Immutable log entry for one delivery attempt, queryable via the delivery
/// log API for debugging subscriber-side failures.
model WebhookDeliveryAttempt {

  id            String          @id @default(uuid())
  delivery      WebhookDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  deliveryId    String
  attemptNumber Int
  attemptedAt   DateTime        @default(now())
  success       Boolean
  statusCode    Int?
  error         String?
  durationMs    Int?

  @@index([deliveryId])
}

/// Persistent audit record written by the DLQ processor when an invoice-
/// reminder job exhausts all Bull retries. One row per exhausted job.
/// Provides an ops-queryable failure log independent of the transient
/// Redis queue state.
model InvoiceReminderFailure {
  id           String   @id @default(uuid())
  /// The invoice that could not be reminded. Stored as a string because the
  /// invoice-reminder module targets a richer schema (User + dueDate) that is
  /// not yet fully migrated; keeps the failure log loosely coupled.
  invoiceId    String
  errorMessage String
  attemptCount Int
  /// Bull job ID for cross-referencing queue history logs.
  jobId        String?
  failedAt     DateTime @default(now())

  @@index([invoiceId])
  @@index([failedAt])
}
